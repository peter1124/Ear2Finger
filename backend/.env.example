# Database
DATABASE_URL=sqlite:///./ear2finger.db

# Auth
SECRET_KEY=your-secret-key-change-in-production

# Qdrant (vector store for AI coach)
# Self-hosted: use default below (no API key required).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Embedding: free local model (no API key). 384 = all-MiniLM-L6-v2, 768 = all-mpnet-base-v2.
QDRANT_VECTOR_SIZE=384
# Optional: override embedding model (must match QDRANT_VECTOR_SIZE)
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
